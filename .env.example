# ============================================
# 命理百科 AI - 环境变量样例
# 复制为 .env 后填写真实值，切勿提交 .env
# ============================================

# --- 数据库 (Neon Postgres) ---
# 用于运行时(走 HTTP driver adapter, Cloudflare 友好)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# 用于 Prisma 迁移(直连, 非pooler)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# 本地开发可用 Docker Postgres:
# DATABASE_URL="postgresql://mingli:mingli@localhost:5432/mingli?schema=public"
# DIRECT_URL="postgresql://mingli:mingli@localhost:5432/mingli?schema=public"

# --- AI (OpenAI 兼容, 通义/DeepSeek) ---
# 通义千问: base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: base_url=https://api.deepseek.com
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY="sk-xxx"
AI_MODEL="deepseek-chat"

# --- 站点 ---
NEXT_PUBLIC_SITE_URL="https://mingli.example.com"
NEXT_PUBLIC_SITE_NAME="命理百科 AI"

# --- 缓存(可选, 第一阶段可空) ---
# Cloudflare KV: 通过 wrangler 绑定, 无需 env
# Upstash Redis:
# REDIS_URL=""
# REDIS_TOKEN=""
