# ============================================================
# 命理百科 AI · 生产环境变量
# 复制为 .env 后填入真实值
# ============================================================

# ---- 数据库 (PostgreSQL) ----
# 本地自建 Postgres / 云 Postgres (Supabase / Neon / RDS ...)
# 说明: Prisma 应用层走 DATABASE_URL，迁移走 DIRECT_URL（Pooler 场景下通常为直连非 pooler 地址）
#
# 示例（VPS 自建 Postgres / docker-compose.prod.yml 中 postgres 服务）：
DATABASE_URL="postgresql://mingli:YOUR_SECURE_PASSWORD@127.0.0.1:5432/mingli?schema=public&sslmode=disable"
DIRECT_URL="postgresql://mingli:YOUR_SECURE_PASSWORD@127.0.0.1:5432/mingli?schema=public&sslmode=disable"
#
# Neon Serverless（可无缝替换）:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# ---- AI（OpenAI 兼容协议：通义 / DeepSeek / Kimi ...）----
# 推荐 DeepSeek：性价比高、中文命理解释强
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AI_MODEL="deepseek-chat"
AI_PROVIDER="deepseek"
#
# 通义千问兼容接口：
# AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# AI_API_KEY="sk-xxx"
# AI_MODEL="qwen-max"
# AI_PROVIDER="qwen"

# ---- 站点 ----
# 用于 metadata canonical / OpenGraph / sitemap.xml / robots.txt，必须写完整 https 域名 + 端口(若非443)
NEXT_PUBLIC_SITE_URL="https://mingli.example.com"
NEXT_PUBLIC_SITE_NAME="命理百科 AI"

# ---- 缓存（可选）----
# Upstash / 自建 Redis：用于限流/结果缓存（V1 非必需，注释即可）
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_TOKEN=""

# ---- Node / Next 运行时 ----
# 建议 70%~80% 内存，防止 OOM：2G VPS -> 1536
NODE_OPTIONS="--max-old-space-size=1536"
